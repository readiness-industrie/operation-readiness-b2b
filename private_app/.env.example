DEBUG=false
SECRET_KEY=generate-a-long-random-secret
FIELD_ENCRYPTION_KEY=generate-with-fernet-generate-key
BACKUP_ENCRYPTION_KEY=generate-with-a-different-fernet-key
ALLOWED_HOSTS=private.example.fr
CSRF_TRUSTED_ORIGINS=https://private.example.fr
DATABASE_URL=postgresql://app_user:password@private-host/readiness
OBJECT_STORAGE_BUCKET=readiness-private
OBJECT_STORAGE_ENDPOINT_URL=https://s3.fr-par.scw.cloud
OBJECT_STORAGE_REGION=fr-par
OBJECT_STORAGE_ACCESS_KEY=set-in-host-secret-store
OBJECT_STORAGE_SECRET_KEY=set-in-host-secret-store
REQUIRE_MALWARE_SCAN=true
SESSION_MAX_AGE_SECONDS=3600
MAX_UPLOAD_BYTES=15728640
